<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ptmap</AssemblyName>
    <RootNamespace>PtMapper.Tool</RootNamespace>
    <Version>0.1.19</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PtMapper.Conversion\PtMapper.Conversion.csproj" />
  </ItemGroup>
  <!-- The analysis bundle, built by 'npm run build' in web/. It is optional for the
       build: only 'ptmap analyze' needs it, and says so when it is missing. -->
  <ItemGroup>
    <None Include="..\..\web\dist-node\ptmap-analysis.mjs" Condition="Exists('..\..\web\dist-node\ptmap-analysis.mjs')"
          Link="ptmap-analysis.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
