<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml"><net id="quality_gate" type="http://www.pnml.org/version-2009/grammar/ptnet"><name><text>Quality gate</text></name><page id="quality_gate_page"><place id="p_waiting"><name><text>Waiting</text></name><initialMarking><text>2</text></initialMarking><graphics><position x="125" y="225" /><dimension x="50" y="50" /></graphics></place><place id="p_ok"><name><text>Result OK</text></name><graphics><position x="305" y="125" /><dimension x="50" y="50" /></graphics></place><place id="p_nok"><name><text>Result NOK</text></name><graphics><position x="305" y="325" /><dimension x="50" y="50" /></graphics></place><place id="p_shipped"><name><text>Shipped</text></name><graphics><position x="645" y="125" /><dimension x="50" y="50" /></graphics></place><place id="p_scrapped"><name><text>Scrapped</text></name><graphics><position x="645" y="325" /><dimension x="50" y="50" /></graphics></place><transition id="t_inspect"><name><text>Inspect</text></name><graphics><position x="215" y="225" /><dimension x="50" y="50" /></graphics></transition><transition id="t_approve"><name><text>Approve</text></name><graphics><position x="475" y="125" /><dimension x="50" y="50" /></graphics></transition><transition id="t_reject"><name><text>Reject</text></name><graphics><position x="475" y="325" /><dimension x="50" y="50" /></graphics></transition><transition id="t_rework"><name><text>Rework</text></name><graphics><position x="385" y="455" /><dimension x="50" y="50" /></graphics></transition><arc id="a1" source="p_waiting" target="t_inspect" /><arc id="a2" source="t_inspect" target="p_ok" /><arc id="a3" source="t_inspect" target="p_nok" /><arc id="a4" source="p_ok" target="t_approve" /><arc id="a5" source="t_approve" target="p_shipped" /><arc id="a6" source="p_nok" target="t_reject" /><arc id="a7" source="t_reject" target="p_scrapped" /><arc id="a8" source="p_scrapped" target="t_rework"><inscription><text>2</text></inscription></arc><arc id="a9" s