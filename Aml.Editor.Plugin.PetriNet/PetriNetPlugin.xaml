<aml:PluginViewBase
    x:Class="Aml.Editor.Plugin.PetriNet.PetriNetPlugin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:aml="clr-namespace:Aml.Editor.Plugin.WPFBase;assembly=Aml.Editor.Plugin.Contract"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="900">

    <aml:PluginViewBase.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </aml:PluginViewBase.Resources>

    <TabControl>
        <TabItem Header="Petri net">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <!-- A GridSplitter can only resize a row with a concrete
                         height, so this one is sized in pixels and collapses to
                         zero while the panel is hidden. -->
                    <RowDefinition Height="0" x:Name="FindingsRow"/>
                </Grid.RowDefinitions>

                <!-- The same toolbar the FPD plugin shows per hierarchy: glyphs in
                     the editor's icon font next to short labels, so the two plugins
                     read as one family side by side. A ToolBar moves what does not
                     fit into its overflow instead of cutting it off. -->
                <ToolBar Grid.Row="0">
                    <ToolBar.Resources>
                        <Style x:Key="IconText" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                        </Style>
                    </ToolBar.Resources>

                    <Button x:Name="UpdateButton"
                            Click="UpdateButton_Click"
                            ToolTip="Update InstanceHierarchy: write the diagram back into the AML document, keeping anything you added by hand.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE895;" Foreground="#E08020"/>
                            <TextBlock Text="Update" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            ToolTip="Refresh from AML: discard the diagram and reload it from the AML document.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" Foreground="#2070C0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator/>

                    <!-- What a session needs every time stays a button of its own.
                         Creating, importing and exporting happen now and then, so
                         they share one menu, and the toolbar does not grow with every
                         command added later. They are deliberately not on the editor
                         toolbar: it shows the commands of one plugin at a time, which
                         put the FPD commands into this tab or doubled these. -->
                    <Button x:Name="NetMenuButton"
                            Click="NetMenuButton_Click"
                            ToolTip="Create, import, simulate, analyse or export a Petri net.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE700;" Foreground="#606060"/>
                            <TextBlock Text="Net &#x25BE;" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="NetMenu">
                                <MenuItem x:Name="NewNetItem"
                                          Header="New Net"
                                          ToolTip="Add an empty Petri net instance hierarchy to the current AML document."/>
                                <MenuItem x:Name="ImportPnmlItem"
                                          Header="Import PNML..."
                                          ToolTip="Load a .pnml file and add its net as a new instance hierarchy."/>
                                <Separator/>
                                <MenuItem x:Name="SimulateItem"
                                          Header="Simulate"
                                          ToolTip="Fire the net on the canvas. A run never changes the document."/>
                                <MenuItem x:Name="AnalyseItem"
                                          Header="Analyse"
                                          ToolTip="Check boundedness, deadlocks and invariants of the net and open the list on the canvas."/>
                                <Separator/>
                                <MenuItem Header="Export PNML..."
                                          ToolTip="Save the current net as a PNML file (ISO/IEC 15909-2)."
                                          Click="ExportButton_Click"/>
                                <MenuItem Header="Export SVG..."
                                          ToolTip="Save the diagram as an SVG picture, as it is drawn on the canvas."
                                          Click="ExportSvgButton_Click"/>
                                <MenuItem Header="Save Conformance Report..."
                                          ToolTip="Write the ISO/IEC 15909-1 check of the current net to a Markdown file, including which rules were applied."
                                          Click="SaveReportButton_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Every Petri net of the document, whichever hierarchy holds it.
                         Hidden while there is only one. -->
                    <Separator x:Name="NetSelectorSeparator" Visibility="Collapsed"/>
                    <TextBlock x:Name="NetSelectorLabel"
                               Text="Net:"
                               VerticalAlignment="Center"
                               Margin="4,0,4,0"
                               Visibility="Collapsed"/>
                    <ComboBox x:Name="NetSelector"
                              MinWidth="160"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              ToolTip="This document holds more than one Petri net. Pick the one to show."
                              SelectionChanged="NetSelector_SelectionChanged"/>

                    <Separator/>
                    <!-- The findings of the automatic check, shown only when there are any. -->
                    <Button x:Name="FindingsButton"
                            Click="FindingsButton_Click"
                            Visibility="Collapsed"
                            ToolTip="Show or hide what the ISO/IEC 15909-1 check and the reading of the document found.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="#C08000"/>
                            <TextBlock x:Name="FindingsButtonText" Text="Findings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatusLabel"
                               Text=""
                               VerticalAlignment="Center"
                               Foreground="#666"
                               FontStyle="Italic"
                               Margin="6,0"/>
                    <TextBlock x:Name="PendingLabel"
                               Text=""
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Foreground="#B36B00"
                               FontSize="11"/>
                </ToolBar>

                <Grid Grid.Row="1">
                    <wv2:WebView2 x:Name="Modeler"/>
                    <Border x:Name="NoDocumentPlaceholder" Background="#F8F8F8" Visibility="Visible">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#666"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="520"
                                   Text="Open an AML document. Use New Net or Import PNML in the Net menu above to add a Petri net, or open a document that already contains a PT_Net instance hierarchy."/>
                    </Border>
                </Grid>

                <GridSplitter x:Name="FindingsSplitter"
                              Grid.Row="2"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="#DDD"
                              Visibility="Collapsed"/>

                <Grid Grid.Row="3" x:Name="FindingsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,2">
                        <TextBlock x:Name="FindingsSummary" Text="" VerticalAlignment="Center" FontSize="11"/>
                        <Button x:Name="SaveReportButton"
                                Content="Save report"
                                Padding="6,1"
                                Margin="12,0,0,0"
                                FontSize="11"
                                ToolTip="Write the validation result to a Markdown file, including which rules were applied."
                                Click="SaveReportButton_Click"/>
                        <Button x:Name="CloseFindingsButton"
                                Content="Hide"
                                Padding="6,1"
                                Margin="6,0,0,0"
                                FontSize="11"
                                Click="CloseFindingsButton_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="FindingsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              FontSize="11"
                              SelectionMode="Single"
                              MouseDoubleClick="FindingsGrid_MouseDoubleClick"
                              ToolTip="Double-click a finding to select the element it refers to.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="70"/>
                            <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="55"/>
                            <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="130"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Status / Diagnostics">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Petri net editor (ISO/IEC 15909)"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,0,0,6"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox x:Name="SaveAfterUpdateToggle"
                              Content="Save the document after Update"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="Update writes the diagram into the document. With this on, the editor's save command runs afterwards, so the change reaches the file."
                              Checked="SettingsToggle_Changed"
                              Unchecked="SettingsToggle_Changed"/>
                    <CheckBox x:Name="AskBeforeLargeUpdatesToggle"
                              Content="Ask before large changes"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0"
                              ToolTip="Ask for confirmation when an Update would add or remove more elements than the number beside this box."
                              Checked="SettingsToggle_Changed"
                              Unchecked="SettingsToggle_Changed"/>
                    <TextBox x:Name="LargeUpdateThresholdInput"
                             Width="34"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"
                             ToolTip="How many added or removed elements count as a large change."
                             LostFocus="ThresholdInput_Changed"/>
                    <CheckBox x:Name="FollowSelectionToggle"
                              Content="Follow the canvas in the tree"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="Select the element in the editor's tree when it is clicked on the canvas."
                              Checked="SettingsToggle_Changed"
                              Unchecked="SettingsToggle_Changed"/>
                    <CheckBox x:Name="DebugToggle"
                              Content="Verbose debug logging"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Checked="DebugToggle_Changed"
                              Unchecked="DebugToggle_Changed"/>
                    <Button x:Name="OpenLogFolderButton"
                            Content="Open log folder"
                            Padding="8,2"
                            Click="OpenLogFolderButton_Click"/>
                    <TextBlock x:Name="LogFilePathLabel"
                               Text=""
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#888"
                               FontSize="11"/>
                </StackPanel>

                <TextBox Grid.Row="2"
                         x:Name="StatusLog"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="11"
                         BorderThickness="1"
                         BorderBrush="#CCC"
                         Padding="4"
                         Text="Ready."/>
            </Grid>
        </TabItem>
    </TabControl>
</aml:PluginViewBase>
