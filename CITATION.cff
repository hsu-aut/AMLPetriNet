    given-names: Hamied
    affiliation: "Helmut Schmidt University / University of the Federal Armed Forces Hamburg"
version: 0.1.18
date-released: 2026-11-14
license: MIT
repository-code: "https://github.com/hsu-aut/AMLPetriNet"
keywords:
  - AutomationML
  - Petri net
  - PNML
  - ISO/IEC 15909
  - modeler
